{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scholarship.py": {
      "maxDuration": 15,
      "includeFiles": "backend/app/data/**",
      "excludeFiles": "{dist/**,frontend/**,node_modules/**,.venv/**,backend/tests/**,backend/tinyfish_probe.py,**/.env*}"
    }
  }
}
